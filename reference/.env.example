# Скопируй этот файл в .env и заполни значения.
# .env в .gitignore — никогда не коммить.

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app

# Backend
JWT_SECRET=change-me-to-a-random-string-min-32-chars
ENVIRONMENT=development

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# External services (если используются — раскомментируй и заполни)
# STRIPE_SECRET_KEY=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# OPENAI_API_KEY=
